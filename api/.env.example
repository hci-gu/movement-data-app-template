# Copy to .env (ignored), or inject these into the backend environment.
KONTOAPI_ENVIRONMENT=test
KONTOAPI_URL=https://sptest.it.gu.se:9444
KONTOAPI_TOKEN_URL=https://idptest.it.gu.se/adfs/oauth2/token/
KONTOAPI_CLIENT_ID=replace-with-client-id
KONTOAPI_CLIENT_SECRET=replace-with-client-secret
KONTOAPI_API_KEY=replace-with-api-key
STUDY_SECRETS_FILE=./secrets/study-keys.json
# Public HTTPS origin for guardian invitation pages.
BANKID_PUBLIC_URL=https://YOUR_HOST
# Only trust actual ingress peers. Local tunnel: 127.0.0.1/32,::1/128.
TRUSTED_PROXY_CIDRS=
# Optional researcher upload export credential; never put this in Flutter.
# API_KEY=generate-a-separate-random-export-key
# KontoAPI does not document a return URL. Users return manually after BankID.
# Optional legacy app-link hosting is independent of authentication:
# BANKID_APP_IDENTIFIER=com.appademin.swedHeart
# BANKID_IOS_APP_ID=APPLE_APP_ID_PREFIX.com.appademin.swedHeart
# BANKID_RETURN_URL=https://YOUR_HOST/bankid/return
# Test identity mapping support requires a binary built with -tags study_simulation.
# Use a separate, initially empty database. Add mappings in PocketBase afterwards.
# STUDY_DEPLOYMENT=simulation
# STUDY_SIMULATION_ID=scoliosis-test-v1
