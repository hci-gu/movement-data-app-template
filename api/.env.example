# Copy to .env (ignored). Load with: set -a; source .env; set +a
# These paths are relative to the API process working directory.
BANKID_ENVIRONMENT=test
BANKID_APP_IDENTIFIER=org.example.researchSteps
BANKID_RETURN_URL=researchsteps://bankid/return
# Public HTTPS origin of this API for guardian signing links. If BANKID_RETURN_URL
# is HTTPS on the same host, this can be omitted.
BANKID_PUBLIC_URL=https://YOUR_HOST
BANKID_CERT_FILE=./secrets/client.pem
BANKID_KEY_FILE=./secrets/client-key.pem
BANKID_CA_FILE=./secrets/bankid-server-ca.pem
STUDY_SECRETS_FILE=./secrets/study-keys.json
# For HTTPS returns, use https://YOUR_HOST/bankid/return above and set:
# BANKID_IOS_APP_ID=APPLE_APP_ID_PREFIX.org.example.researchSteps
# Only list the actual ingress proxy CIDRs. For a local ngrok agent forwarding
# to this API over loopback, use 127.0.0.1/32,::1/128.
TRUSTED_PROXY_CIDRS=
# Optional researcher export credential. Never put this in Flutter.
# API_KEY=generate-a-separate-random-export-key
# Certificate rotation restarts the process; pending attempts must be retried.
